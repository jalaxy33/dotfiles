# ~/.bashrc
#
# Necessary:
#  - bash, starship, vim(or gvim)
#  - zoxide, fzf, eza, yazi, jq, ripgrep, fd
#
# Optional but useful:
#  - bat, helix, rsync, neovim, fastfetch, lazygit
#  - jujutsu, lazyjj
#
# bash specific:
#  - flyline, bash-completion

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

#==========================================
# Imports
#==========================================

BASH_CONFIGS="$HOME/.config/bash"

# Load configs in `$BASH_CONFIGS/`
source "$BASH_CONFIGS/functions.sh"
source "$BASH_CONFIGS/env.sh"
source "$BASH_CONFIGS/aliases.sh"
source "$BASH_CONFIGS/paths.sh"
source "$BASH_CONFIGS/languages.sh"

#==========================================
# Init Apps
#==========================================

# try to activate homebrew (if installed)
BREW_CMD="/home/linuxbrew/.linuxbrew/bin/brew"
[[ -f $BREW_CMD ]] && eval "$($BREW_CMD shellenv)"

# init apps
command_exists starship && eval "$(starship init bash)"
command_exists zoxide && eval "$(zoxide init bash --cmd cd)"
command_exists fzf && eval "$(fzf --bash)"
command_exists jj && source <(jj util completion bash)

#==========================================
# Bash specific
#==========================================

# load bash specific configs
source "$BASH_CONFIGS/bash-specific/shell-configs.sh"
source "$BASH_CONFIGS/bash-specific/bash-apps.sh"

#
# -- bash specific apps --
#

# bash-completion
activate_bash_completion

# flyline -- fish-like interactive behavior
# activate_flyline
