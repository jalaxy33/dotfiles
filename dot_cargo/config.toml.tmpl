# ~/.cargo/config.toml 
# or  ~/.cargo/config
# or  <PROJECT_ROOT>/.cargo/config.toml


#-- mirrors
[source.crates-io]
replace-with = 'rsproxy-sparse'

[source.rsproxy]
registry = "https://rsproxy.cn/crates.io-index"

[source.rsproxy-sparse]
registry = "sparse+https://rsproxy.cn/index/"

[registries.rsproxy]
index = "https://rsproxy.cn/crates.io-index"

[net]
git-fetch-with-cli = true


{{- if (and (eq .chezmoi.os "linux") (and (lookPath "clang") (lookPath "mold"))) }} 

#-- faster linker on linux
# install `clang` & `mold`
## reference: https://bevy.org/learn/quick-start/getting-started/setup/#enable-fast-compiles-optional
[target.'cfg(target_os = "linux")']
linker = "clang"
rustflags = ["-C", "link-arg=-fuse-ld={{- lookPath "mold" }}"]

{{- end }}
