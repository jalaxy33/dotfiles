#!/usr/bin/env bash
#
# set_rust_toolchain — Switch default Rust toolchain and sync ~/.cargo/config.toml
#
# Usage:
#   ./set_rust_toolchain stable
#   ./set_rust_toolchain nightly
#   ./set_rust_toolchain help
#
# Note: an argument is required (no default).
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CARGO_DIR="$HOME/.cargo"

usage() {
    cat <<'EOF'
Usage: set_rust_toolchain <stable|nightly>

  stable   switch to stable
  nightly  switch to nightly
  help     show this help
EOF
}

# ---------- validate argument ----------
TOOLCHAIN="${1:-}"
if [[ -z "$TOOLCHAIN" ]]; then
    echo "Error: missing argument (choose: stable | nightly)" >&2
    usage >&2
    exit 1
fi
case "$TOOLCHAIN" in
    stable|nightly) ;;
    help|-h|--help)
        usage
        exit 0
        ;;
    *)
        echo "Error: unknown argument '$TOOLCHAIN' (choose: stable | nightly | help)" >&2
        usage >&2
        exit 1
        ;;
esac

# ---------- print and run a command ----------
run() {
    echo "\$ $*"
    "$@"
}

# ---------- stable ----------
switch_to_stable() {
    echo "==> Switching to stable"
    run rustup default stable
    run cp "$SCRIPT_DIR/config-stable.toml" "$CARGO_DIR/config.toml"
    echo "==> Done: $(rustup default)"
}

# ---------- nightly ----------
switch_to_nightly() {
    echo "==> Switching to nightly"

    # check if nightly is installed
    if rustup toolchain list | grep -q '^nightly'; then
        echo "==> nightly already installed"
    else
        echo "==> nightly not installed"
        read -r -p "Install nightly? [Y/n] " answer
        case "${answer:-y}" in
            y|Y|yes|YES|Yes)
                echo "==> Installing..."
                run rustup toolchain install nightly
                ;;
            *)
                echo "==> Skipping install, falling back to stable"
                switch_to_stable
                return
                ;;
        esac
    fi

    run rustup default nightly
    run cp "$SCRIPT_DIR/config-nightly.toml" "$CARGO_DIR/config.toml"
    echo "==> Done: $(rustup default)"
}

# ---------- main ----------
mkdir -p "$CARGO_DIR"

case "$TOOLCHAIN" in
    nightly) switch_to_nightly ;;
    stable)  switch_to_stable ;;
esac
