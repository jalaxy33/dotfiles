# ~/.zshrc
#
# Necessary:
#  - zsh, vim(or gvim)
#  - zoxide, fzf, eza, yazi, lazygit, jq, ripgrep, fd
#
# Beautify:
#  - zimfw or starship
#
# Optional but useful:
#  - bat, helix, rsync, neovim, fastfetch, lazygit
#  - jujutsu, lazyjj
#
# Reference:
#   - https://www.bilibili.com/video/BV1fdTfzeE8X/

#==========================================
# Imports
#==========================================

BASH_CONFIGS="$HOME/.config/bash"
ZSH_CONFIGS="$HOME/.config/zsh"

# Load configs in `$BASH_CONFIGS/`
source "$BASH_CONFIGS/functions.sh"
source "$BASH_CONFIGS/env.sh"
source "$BASH_CONFIGS/aliases.sh"
source "$BASH_CONFIGS/paths.sh"
source "$BASH_CONFIGS/languages.sh"

# Load configs in $ZSH_CONFIGS/`
source "$ZSH_CONFIGS/zsh_functions.zsh"
source "$ZSH_CONFIGS/zsh_keybinds.zsh"
source "$ZSH_CONFIGS/zsh_aliases.zsh"

#==========================================
# Init Apps
#==========================================

# try to activate homebrew (if installed)
BREW_CMD="/home/linuxbrew/.linuxbrew/bin/brew"
[[ -f $BREW_CMD ]] && eval "$($BREW_CMD shellenv)"

# uncomment to use zimfw
activate_zimfw

# do if not using zimfw
if ! is_zimfw_loaded; then
  # fix: command not found: compdef
  autoload -Uz compinit && compinit

  # starship is unnecessary when using zimfw
  command_exists starship && eval "$(starship init zsh)"
fi

# init apps
command_exists zoxide && eval "$(zoxide init zsh --cmd cd)"
command_exists fzf && source <(fzf --zsh)
command_exists jj && source <(jj util completion zsh)
