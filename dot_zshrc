# ~/.zshrc
#
# Necessary:
#  - zsh, vim(or gvim)
#  - zoxide, fzf, eza, yazi, lazygit, jq, ripgrep, fd
#
# Beautify:
#  - zimfw or starship
#
# Optional but useful:
#  - bat, helix, rsync, neovim, fastfetch, lazygit
#
# Reference:
#   - https://www.bilibili.com/video/BV1fdTfzeE8X/

#==========================================
# Imports
#==========================================

# Load configs in `~/.bash/`
source "$HOME/.bash/functions.sh"
source "$HOME/.bash/env.sh"
source "$HOME/.bash/aliases.sh"
source "$HOME/.bash/paths.sh"
source "$HOME/.bash/languages.sh"

# Load configs in `~/.config/zsh/`
source "$HOME/.config/zsh/zsh_functions.zsh"
source "$HOME/.config/zsh/zsh_keybinds.zsh"
source "$HOME/.config/zsh/zsh_aliases.zsh"

#==========================================
# Init Apps
#==========================================

# try to activate homebrew (if installed)
BREW_CMD="/home/linuxbrew/.linuxbrew/bin/brew"
[[ -f $BREW_CMD ]] && eval "$($BREW_CMD shellenv)"

# activate zimfw or starship
activate_zimfw
[[ ! is_zimfw_loaded ]] && command_exists starship && eval "$(starship init zsh)"

# init apps
command_exists zoxide && eval "$(zoxide init zsh --cmd cd)"
command_exists fzf && source <(fzf --zsh)

#==========================================
# zsh specific
#==========================================

# fix: command not found: compdef
[[ ! is_zimfw_loaded ]] && autoload -Uz compinit && compinit
