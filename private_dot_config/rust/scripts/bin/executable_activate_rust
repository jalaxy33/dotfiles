#!/usr/bin/env bash
#
# Put ~/.cargo/bin on PATH.
#
# This has to be sourced, a child process cannot change the caller's PATH:
# $ source ~/.config/rust/scripts/bin/activate_rust
#
# (No 'set -euo pipefail' here: sourcing would change the caller's shell.)

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../_lib.sh" || exit 1

prepend_path "$HOME/.cargo/bin"

# tell the user when this runs as a script instead of being sourced
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  printf 'note: run this with "source" to change your PATH:\n' >&2
  printf '      $ source %s\n' "${BASH_SOURCE[0]}" >&2
fi
