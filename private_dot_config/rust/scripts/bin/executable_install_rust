#!/usr/bin/env bash
#
# Install and config rust toolchains

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../_lib.sh" || exit 1

# make the sibling scripts callable
prepend_path "$SCRIPT_DIR"

#======================================
# CLI help info
#======================================

PROG="${0##*/}"

usage() {
  cat <<EOF
Install and config rust toolchains.

Usage: $PROG [OPTIONS]

META OPTIONS:
  -h, --help      Print help
  -v, --version   Print version
EOF
}

cli_base_args "$PROG" "$VERSION" usage "$@"

#======================================
# Main
#======================================

main() {
  local -a tool_list=(cargo-cache cargo-update cargo-binstall)

  # mirrors for rustup itself (the toolchain archives, not crates.io)
  export RUSTUP_DIST_SERVER="https://mirrors.cernet.edu.cn/rustup"
  export RUSTUP_UPDATE_ROOT="https://mirrors.cernet.edu.cn/rustup/rustup"

  if [[ ! -x $HOME/.cargo/bin/rustup ]]; then
    printf '\n==== install: rustup ====\n'
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh
  fi

  # a freshly installed rustup is not on PATH of this process yet
  prepend_path "$HOME/.cargo/bin"

  printf '\n==== install/update: toolchains ====\n'
  printf '\n[Running] rustup toolchain install stable\n'
  rustup toolchain install stable
  printf '\n[Running] rustup toolchain install nightly\n'
  rustup toolchain install nightly

  set_rust_toolchain

  printf '\n==== install: recommended tools ====\n'
  printf '\n[Running] cargo install %s\n' "${tool_list[*]}"
  cargo install "${tool_list[@]}"

  printf '\nDone.\n'
}

main "$@"
