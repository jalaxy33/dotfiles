#!/usr/bin/env bash
#
# Select default rust toolchain

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../_lib.sh" || exit 1

# make the sibling scripts callable
prepend_path "$SCRIPT_DIR"

#======================================
# CLI help info
#======================================

PROG="${0##*/}"

usage() {
  cat <<EOF
Select default rust toolchain.

Usage: $PROG [OPTIONS]

META OPTIONS:
  -h, --help      Print help
  -v, --version   Print version

TOOLCHAIN OPTIONS
  -T, --toolchain <TOOLCHAIN>   Specify rust toolchain [possible values: stable, nightly]
EOF
}

cli_base_args "$PROG" "$VERSION" usage "$@"

#======================================
# Main
#======================================

main() {
  local toolchain="" use_nightly="" channel=""

  toolchain="$(parse_toolchain_flag "$@")"

  printf '\n==== setup: default toolchain ====\n\n'
  use_nightly="$(resolve_toolchain "$toolchain")"

  if is_true "$use_nightly"; then
    channel="nightly"
  else
    channel="stable"
  fi

  printf '\n[Running] rustup default %s\n\n' "$channel"
  rustup default "$channel"

  printf '\n==== generate: config files ====\n\n'
  printf '[Running] setup_cargo --toolchain %s\n' "$channel"
  setup_cargo --toolchain "$channel"
}

main "$@"
