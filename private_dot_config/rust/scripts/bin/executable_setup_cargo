#!/usr/bin/env bash
#
# Generate `.cargo/config.toml` & 'rustfmt.toml'
#

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../_lib.sh" || exit 1

#======================================
# CLI help info
#======================================

PROG="${0##*/}"

usage() {
  cat <<EOF
Generate .cargo/config.toml & rustfmt.toml

Usage: $PROG [OPTIONS]

META OPTIONS:
  -h, --help      Print help
  -v, --version   Print version

TOOLCHAIN OPTIONS
  -T, --toolchain <TOOLCHAIN>   Specify rust toolchain [possible values: stable, nightly]

OUTPUT OPTIONS
  -d, --dir <DIR>               Default folder to save into (must exist)
EOF
}

cli_base_args "$PROG" "$VERSION" usage "$@"

#======================================
# Templates
#======================================

# one source per generated file, optional parts sit in '#>>> <tag>' blocks
TMPL_ROOT="$RUST_DIR/templates"
TMPL_cargo_config="$TMPL_ROOT/cargo-config.src.toml"
TMPL_rustfmt_src="$TMPL_ROOT/rustfmt.src.toml"

#======================================
# Helper Funcs
#======================================

# ask_workdir <label> <default>: print an existing dir on stdout, 1 on give-up
ask_workdir() {
  local label="$1" default="$2" workdir

  if confirm " -> Save as '$default/$label'"; then
    printf '%s\n' "$default"
    return 0
  fi

  while true; do
    workdir=$(collect_answer " -> Input another folder" "$default") || return 1
    workdir="${workdir/#\~/$HOME}"
    [[ -d $workdir ]] && {
      printf '%s\n' "$workdir"
      return 0
    }
    printf "  [Error] '%s' is not an existing folder.\n" "$workdir" >&2
    confirm '  -> Give up saving?' "n" && return 1
  done
}

# save_file_with_backup <target> <content>
#
# Declining the backup means "keep the existing file", never overwrite it.
save_file_with_backup() {
  local target="$1" content="$2" bak="${1%.toml}.bak.toml"

  mkdir -p "$(dirname "$target")"

  if [[ -e $target ]]; then
    if ! confirm " -> '$target' exists. Back it up as '$(basename "$bak")'?"; then
      printf '  [SKIP] %s kept, nothing written.\n' "$target" >&2
      return 0
    fi

    if [[ -e $bak ]] && ! confirm " -> '$(basename "$bak")' exists. Replace it?"; then
      printf '  [WARN] backup skipped, the old backup is kept.\n' >&2
    else
      cp -p "$target" "$bak" || {
        printf '  [Error] failed to back up %s\n' "$target" >&2
        return 1
      }
      printf '  [Done] backed up to %s\n' "$bak"
    fi
  fi

  printf '%s' "$content" >"$target"
  printf '[Done] saved to %s\n' "$target"
}

#======================================
# Process Funcs
#======================================

# '.cargo/config.toml'
#
# One source file, the picks only decide which '#>>> <tag>' blocks stay.
gen_cargo_config() {
  local text=""
  local choice=""
  local use_nightly="${1-}"
  local -a keep=()

  if ! isin "$use_nightly" "0" "1"; then
    echo "[Error] no valid 'use_nightly' argument: '$use_nightly'" >&2
    exit 1
  fi

  # mirror
  choice=$(choose_from 'Choose Mirror: (a) USTC, (b) cernet, (c) No Mirror.' a a b c) || choice=""
  case "$choice" in
    a) keep+=(mirror_ustc) ;;
    b) keep+=(mirror_cernet) ;;
  esac

  # linker
  if ! command_exist clang || ! command_exist mold; then
    echo "[WARN] skipping mold: need both clang and mold" >&2
  elif confirm 'Use mold linker?'; then
    keep+=(mold)
  fi

  # nightly-only rustflags
  if is_true "$use_nightly" && confirm 'Use nightly rustflags?'; then
    keep+=(nightly)
  fi

  # cranelift
  if is_true "$use_nightly" && confirm 'Use cranelift?' "n"; then
    if ! command_exist rustup; then
      echo "[WARN] command 'rustup' not exist! Skipping cranelift." >&2
    elif [[ -z $(rustup component list --installed --toolchain nightly | grep cranelift) ]]; then
      echo "[WARN] component 'cranelift' not found! Skipping cranelift. Install it by:" >&2
      echo "$ rustup component add rustc-codegen-cranelift-preview --toolchain nightly" >&2
    else
      keep+=(cranelift)
    fi
  fi

  require_paths "$TMPL_cargo_config"
  validate_blocks "$TMPL_cargo_config"
  text=$(read_trimmed "$TMPL_cargo_config" | filter_blocks "${keep[@]}")
  printf "%s" "$text"
}

# rustfmt
gen_rustfmt() {
  local text=""
  local key=""
  local use_nightly="${1-}"
  local -a keep=()

  if ! isin "$use_nightly" "0" "1"; then
    echo "[Error] no valid 'use_nightly' argument: '$use_nightly'" >&2
    exit 1
  fi

  require_paths "$TMPL_rustfmt_src"
  validate_blocks "$TMPL_rustfmt_src"
  is_true "$use_nightly" && keep+=(nightly)

  text=$(read_trimmed "$TMPL_rustfmt_src" | filter_blocks "${keep[@]}")

  # stable ignores the nightly-only options but warns for each one, so drop them
  if ! is_true "$use_nightly"; then
    for key in $(block_keys "$TMPL_rustfmt_src" nightly); do
      if grep -qE "^$key[[:space:]]*=" <<<"$text"; then
        echo "[Error] stable rustfmt still has nightly-only option '$key'." >&2
        echo "        Check the '#>>> nightly' blocks in $TMPL_rustfmt_src" >&2
        exit 1
      fi
    done
  fi

  printf "%s" "$text"
}

# save_cargo_config <default-dir> <content>
save_cargo_config() {
  local dir="$1" content="$2" workdir

  confirm "Save '.cargo/config.toml'?" || return 0
  workdir=$(ask_workdir '.cargo/config.toml' "${dir:-$HOME}") || return 0
  save_file_with_backup "$workdir/.cargo/config.toml" "$content"
  echo ""
}

# save_rustfmt <default-dir> <content>
#
# One file, the content follows the chosen channel: nightly gives the unstable
# options, stable the plain ones.
save_rustfmt() {
  local dir="$1" content="$2" workdir

  confirm "Save 'rustfmt.toml'?" || return 0
  workdir=$(ask_workdir 'rustfmt.toml' "${dir:-$HOME/.config/rustfmt}") || return 0
  save_file_with_backup "$workdir/rustfmt.toml" "$content"
  echo ""
}

# show <title> <content>: print a generated file between rulers
show() {
  printf '\n-----[ %s ]\n' "$1"
  printf '\n%s' "$2"
  printf '\n------------------------------------------------\n\n'
}

#======================================
# Main
#======================================

main() {
  local -a rest=()
  local toolchain=""
  local out_dir=""
  local use_nightly=""
  local body=""
  local rustfmt_body=""

  # '--dir' is setup_cargo only, pull it out before the shared parser runs
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -d | --dir)
        if [[ -z ${2-} ]]; then
          printf 'error: %s needs a value\n' "$1" >&2
          exit 1
        fi
        out_dir="$2"
        shift 2
        ;;
      --dir=*)
        out_dir="${1#*=}"
        shift
        ;;
      *)
        rest+=("$1")
        shift
        ;;
    esac
  done

  out_dir="${out_dir/#\~/$HOME}"
  if [[ -n $out_dir && ! -d $out_dir ]]; then
    printf 'error: --dir is not an existing folder: %s\n' "$out_dir" >&2
    exit 1
  fi

  toolchain="$(parse_toolchain_flag "${rest[@]}")"

  # make sure related paths exist
  require_paths "$TMPL_ROOT"

  if [[ ! -d $HOME/.cargo ]]; then
    printf "\n[WARN] missing '%s/.cargo'\n[Running] mkdir -p %s/.cargo\n" "$HOME" "$HOME"
    mkdir -p "$HOME/.cargo"
  fi

  printf "\n> generating '.cargo/config.toml' & 'rustfmt.toml'\n\n"

  use_nightly="$(resolve_toolchain "$toolchain")"
  # cargo config: header, mirror, target table, profiles, lints
  body="$(gen_cargo_config "$use_nightly")"$'\n'
  rustfmt_body="$(gen_rustfmt "$use_nightly")"$'\n'

  # a stable config must not carry nightly-only keys, they break the build
  if ! is_true "$use_nightly"; then
    if grep -qE -- '^[[:space:]]*"-Z|^\[unstable\]' <<<"$body"; then
      printf "[Error] stable '.cargo/config.toml' still has nightly-only keys.\n" >&2
      printf "        Check the '#>>> nightly' blocks in %s\n" "$TMPL_cargo_config" >&2
      exit 1
    fi
  fi

  printf "\n> '.cargo/config.toml' & 'rustfmt.toml' are generated.\n\n"

  save_cargo_config "$out_dir" "$body"
  save_rustfmt "$out_dir" "$rustfmt_body"

  confirm "Display the generated '.cargo/config.toml'?" "n" &&
    show '.cargo/config.toml' "$body"
  confirm "Display the generated 'rustfmt.toml'?" "n" &&
    show 'rustfmt.toml' "$rustfmt_body"

  return 0
}

main "$@"
