# mirrors.env -- download mirrors, shared by posix and fish
#
# Read with load_dotenv, so a KEY=VALUE per line and "#" comments work.
# Values are literal: no $HOME or command expansion.

# homebrew
HOMEBREW_BREW_GIT_REMOTE=https://mirrors.ustc.edu.cn/brew.git
HOMEBREW_API_DOMAIN=https://mirrors.ustc.edu.cn/homebrew-bottles/api
# HOMEBREW_BOTTLE_DOMAIN=https://mirrors.ustc.edu.cn/homebrew-bottles
HOMEBREW_ARTIFACT_DOMAIN=https://mirrors.ustc.edu.cn/homebrew-bottles

# huggingface
HF_ENDPOINT=https://hf-mirror.com

# rust
RUSTUP_DIST_SERVER=https://mirrors.cernet.edu.cn/rustup
RUSTUP_UPDATE_ROOT=https://mirrors.cernet.edu.cn/rustup/rustup

# go
GOPROXY=https://mirrors.tencent.com/go/
