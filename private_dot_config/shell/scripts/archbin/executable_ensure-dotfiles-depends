#!/usr/bin/env bash
#
# Check and install missing dependencies for my dotfiles:
#   https://github.com/jalaxy33/dotfiles
#
# NOTE: Only available for archlinux!
#
set -euo pipefail

. "$(dirname -- "${BASH_SOURCE[0]}")/_deps.sh"

# ==========================================
# CLI args
# ==========================================

usage() {
  cat <<'EOF'
Usage: ensure-dotfiles-depends [OPTION]

Check and install missing dependencies for my dotfiles:
  https://github.com/jalaxy33/dotfiles

NOTE: Only available on Arch Linux.

Options:
  -h, --help  show this help and exit
EOF
}

deps_init "$@"

# ==========================================
# Run before this
# ==========================================

ensure-archlinuxcn

# ==========================================
# List dependencies
# ==========================================

# install by pacman
pac_depends=(
  "wget"
  "paru"
  "fish"
  "starship"
  "zoxide"
  "fzf"
  "eza"
  "jq"
  "ripgrep"
  "fd"
  "lazygit"
  "fastfetch"
  "rsync"
  "helix"
  "bat"
  "bash-completion"
  "nodejs"
  "npm"
  "bun"
  "jujutsu"
  "lazyjj"
  # yazi additional
  "yazi"
  "7zip"
  "ffmpeg"
  "poppler"
  "resvg"
  "imagemagick"
  # rust depends
  "mold"
  "clang"
  # extra LLVM toolchain
  "llvm"
  "lldb"
  "lld"
  "libc++"
)

# install from AUR
aur_depends=(
)

# install from AUR with proxy needed
aur_proxy_depends=(
  "flyline"
  "shorin-contrib-git"
)

# ==========================================
# Main Logic
# ==========================================

install_deps dotfiles pac_depends aur_depends aur_proxy_depends
