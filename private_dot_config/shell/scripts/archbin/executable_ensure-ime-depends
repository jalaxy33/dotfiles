#!/usr/bin/env bash
#
# Check and install missing dependencies for Input Method (fcitx5).
#
# NOTE: Only available for archlinux!
#
set -euo pipefail

. "$(dirname -- "${BASH_SOURCE[0]}")/_deps.sh"

# ==========================================
# CLI args
# ==========================================

usage() {
  cat <<'EOF'
Usage: ensure-ime-depends [OPTION]

Check and install missing dependencies for Input Method (fcitx5).

NOTE: Only available on Arch Linux.

Options:
  -h, --help  show this help and exit
EOF
}

deps_init "$@"

# ==========================================
# Run before this
# ==========================================

ensure-archlinuxcn

# ==========================================
# List dependencies
# ==========================================

# install by pacman
pac_depends=(
  "fcitx5-im"
  "fcitx5-rime"
  "rime-ice-git"
  "rime-wanxiang-gram-zh-hans"
)

# install from AUR
aur_depends=(
)

# install from AUR with proxy needed
aur_proxy_depends=(
)

# ==========================================
# Main Logic
# ==========================================

install_deps ime pac_depends aur_depends aur_proxy_depends
