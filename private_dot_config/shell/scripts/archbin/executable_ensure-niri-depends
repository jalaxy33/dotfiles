#!/usr/bin/env bash
#
# Check and install missing dependencies for my niri dotfiles:
#   https://github.com/jalaxy33/niri-dotfiles
#
# NOTE: Only available for archlinux!
#
set -euo pipefail

. "$(dirname -- "${BASH_SOURCE[0]}")/_deps.sh"

# ==========================================
# CLI args
# ==========================================

usage() {
  cat <<'EOF'
Usage: ensure-niri-depends [OPTION]

Check and install missing dependencies for my niri dotfiles:
  https://github.com/jalaxy33/niri-dotfiles

NOTE: Only available on Arch Linux.

Options:
  -h, --help  show this help and exit
EOF
}

deps_init "$@"
ensure_command "$CURRENT_DIR/ensure-dotfiles-depends"

# ==========================================
# Run before this
# ==========================================

ensure-dotfiles-depends
ensure-ime-depends

# ==========================================
# List dependencies
# ==========================================

# install by pacman
pac_depends=(
  "kitty"
  "fish"
  "thunar"
  "imv"
  "satty"
  "wl-clipboard"
  # GTK theme
  "adw-gtk-theme"
  "nwg-look"
)

# install from AUR
aur_depends=(
)

# install from AUR with proxy needed
aur_proxy_depends=(
  "ttf-jetbrains-maple-mono-nf-xx-xx"
)

# ==========================================
# Main Logic
# ==========================================

install_deps niri pac_depends aur_depends aur_proxy_depends
