#!/usr/bin/env bash
#
# update_dev - update dev environment in once
#
set -euo pipefail

# any failure exits with 1, no matter what the failing command returned
trap 'exit 1' ERR

. "$(dirname -- "${BASH_SOURCE[0]}")/../lib/bash.sh"

CURRENT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)

# add current dir to PATH
PATH="$CURRENT_DIR:$PATH"

# ==========================================
# CLI args
# ==========================================

show_usage() {
  cat <<EOF
Usage: update_dev

Update the dev environment in one go: npm, bun, pi, npx skills, rust, flatpak.

Exit status:
  0  done
  1  failure or bad usage

Options:
  -h, --help      Show this help
EOF
}

case "${1:-}" in
  -h | --help)
    show_usage
    exit 0
    ;;
  "") ;;
  *)
    echo "Error: Unknown argument '$1'. Use --help." >&2
    exit 1
    ;;
esac

# ==========================================
# Precheck
# ==========================================

ensure_command "$CURRENT_DIR/command_exists"

# ==========================================
# Helpers
# ==========================================

# run_update CMD ARGS... - run one update step, skipping when CMD is missing
run_update() {
  command_exists "$1" || return 0
  echo ""
  echo "[Running] $*"
  "$@"
  echo "----------------------------------"
}

# ==========================================
# Main Logic
# ==========================================

run_update npm update -g
run_update bun update -g
run_update pnpm self-update
run_update pnpm update -g
run_update pi update --all
run_update npx skills update -g -y
run_update rustup update

# only when the cargo-update helper is installed
if command_exists cargo && cargo install --list | grep -q "cargo-update"; then
  echo ""
  echo "[Running] cargo install-update --all"
  cargo install-update --all
  echo "----------------------------------"
fi

run_update flatpak update

echo ""
echo "[FINISHED] All Updates."
