// ~/.config/zed/settings.json
//
// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // -- AI设置 --
  // 是否全局禁用AI功能
  "disable_ai": true,
  // 添加自定义模型
  "language_models": {
    "opencode": {
      "show_zen_models": false,
    },
  },
  // 设置自动补全模型
  "edit_predictions": {
    "mode": "subtle",
    "provider": "open_ai_compatible_api",
    "open_ai_compatible_api": {
      "prompt_format": "deepseek_coder",
      "model": "deepseek-flash",
      "api_url": "https://api.deepseek.com/beta/completions",
    },
  },
  // 设置外部agent ACP
  "agent_servers": {
    "pi-acp": {
      "type": "registry",
    },
  },
  // agent面板
  "agent": {
    "threads_sidebar": {
      "position": "right",
    },
    "inline_assistant_model": {
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
      "enable_thinking": false,
    },
    "default_profile": "write",
    "default_model": {
      "effort": "high",
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
      "enable_thinking": true,
    },
    "show_turn_stats": true,
    "notify_when_agent_waiting": "all_screens",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },

  // -- 面板布局 --
  "debugger": {
    "dock": "left",
  },
  "terminal": {
    "shell": {
      "program": "fish",
    },
  },
  "collaboration_panel": {
    "button": false,
  },
  "git_panel": {
    "status_style": "label_color",
    "file_icons": true,
    "tree_view": false,
    "dock": "left",
  },
  "project_panel": {
    "hide_root": true,
    "diagnostic_badges": true,
    "git_status_indicator": true,
    "dock": "left",
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true,
  },
  "tabs": {
    "show_diagnostics": "all",
    "file_icons": true,
    "git_status": true,
  },
  "status_bar": {
    "show_active_file": true,
  },
  "minimap": {
    "show": "auto",
  },

  // -- 编辑器 --
  "vim_mode": false,
  "helix_mode": true,
  "which_key": {
    "delay_ms": 100,
    "enabled": true,
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "completion_menu_scrollbar": "auto",
  "format_on_save": "off",
  "colorize_brackets": true,
  "ui_font_size": 17.0,
  "buffer_font_size": 16.0,

  // -- 软件设置 --
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "auto_update": false,
  "cli_default_open_behavior": "new_window",

  // -- 外观主题 --
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Colored Zed Icons Theme Dark",
  },
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    // 需要安装 `Github Theme` 插件
    "dark": "GitHub Dark Dimmed",
  },

  // -- 编程语言设置 --
  "languages": {
    "Markdown-Inline": {
      "tab_size": 2,
    },
    "Markdown": {
      "tab_size": 2,
    },
    "Lua": {
      "tab_size": 2,
    },

    "Shell Script": {
      "tab_size": 2,
    },
  },

  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        // get more cargo-less diagnostics from rust-analyzer,
        // which might include false-positives (those can be turned off by their names)
        "diagnostics": {
          "experimental": {
            "enable": true,
          },
        },
        // To disable the checking entirely
        // (ignores all cargo and check settings below)
        "checkOnSave": false,
        // To check the `lib` target only.
        "cargo": {
          "allTargets": false,
        },
        // Use `-p` instead of `--workspace` for cargo check
        "check": {
          "workspace": false,
        },
      },
    },
  },
}
