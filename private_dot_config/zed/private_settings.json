// ~/.config/zed/settings.json
//
// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // ===========================
  // 软件设置
  // ===========================

  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "auto_update": false,
  "cli_default_open_behavior": "new_window",

  // ===========================
  // 编辑器设置
  // ===========================

  // --- 代码编辑 ---

  // 默认缩进空格数
  "tab_size": 2,

  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "completion_menu_scrollbar": "auto",
  "format_on_save": "off",

  // --- vim/helix模式 ---

  // vim_mode/helix_mode互斥
  "vim_mode": false,
  "helix_mode": false,

  "vim": {
    // 系统剪贴板选项对helix_mode无效
    "use_system_clipboard": "always",
  },
  // which-key仅对helix_mode生效
  "which_key": {
    "delay_ms": 200,
    "enabled": true,
  },

  // --- 外观&字体 ---

  "colorize_brackets": true,
  "ui_font_size": 17.0,
  "buffer_font_size": 16.0,
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Colored Zed Icons Theme Dark",
  },
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    // 需要安装 `Github Theme` 插件
    "dark": "GitHub Dark Dimmed",
  },
  // --- 面板布局 ---

  "debugger": {
    "dock": "left",
  },
  "terminal": {
    "shell": {
      "program": "fish",
    },
  },
  "collaboration_panel": {
    "button": false,
  },
  "git_panel": {
    "status_style": "label_color",
    "file_icons": true,
    "tree_view": false,
    "dock": "left",
  },
  "project_panel": {
    "hide_root": true,
    "diagnostic_badges": true,
    "git_status_indicator": true,
    "dock": "left",
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true,
  },
  "tabs": {
    "show_diagnostics": "all",
    "file_icons": true,
    "git_status": true,
  },
  "status_bar": {
    "show_active_file": true,
  },
  "minimap": {
    "show": "auto",
  },

  // ===========================
  // AI功能
  // ===========================

  // 是否全局禁用AI功能
  "disable_ai": true,

  // agent面板
  "agent": {
    "threads_sidebar": {
      "position": "right",
    },
    "show_turn_stats": true,
    "notify_when_agent_waiting": "all_screens",
    "dock": "right",
  },

  // ===========================
  // 编程语言与LSP设置
  // ===========================

  // 设置代码提示来源（LSP/treesitter/结合）
  "semantic_tokens": "combined",

  // 各语言特定设置
  "languages": {
    "Python": {
      "tab_size": 4
    },
    "Rust": {
      "tab_size": 4
    },
    "Zig": {
      "tab_size": 4
    },
    "TypeScript": {
      "preferred_line_length": 90,
    },
  },

  // lsp设置
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        // get more cargo-less diagnostics from rust-analyzer,
        // which might include false-positives (those can be turned off by their names)
        "diagnostics": {
          "experimental": {
            "enable": true,
          },
        },
        // To disable the checking entirely
        // (ignores all cargo and check settings below)
        "checkOnSave": false,
        // To check the `lib` target only.
        "cargo": {
          "allTargets": false,
        },
        // Use `-p` instead of `--workspace` for cargo check
        "check": {
          "workspace": false,
        },
      },
    },
  },
}
